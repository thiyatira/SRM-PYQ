# Browser -> Express API base URL.
# The backend only accepts requests from origins in its CORS_ORIGIN allowlist
# (backend env, default http://localhost:3000), so the origin this app is served
# from must be listed there.
NEXT_PUBLIC_SRM_API_BASE=http://localhost:5000

# Google Analytics Measurement ID (optional). Leave unset/empty to disable analytics.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Public site URL used for OpenGraph metadata (optional)
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
