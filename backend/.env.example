# Port the API listens on (frontend NEXT_PUBLIC_SRM_API_BASE must match, e.g. http://localhost:5000)
PORT=5000

# Interface to bind. Defaults to 127.0.0.1 (loopback only). This API handles student
# credentials and has no auth of its own; do not widen this unless the port is behind a
# private network / trusted proxy (e.g. 0.0.0.0 inside a container with an unpublished or
# 127.0.0.1-published port).
HOST=127.0.0.1

# Comma-separated list of browser origins allowed to call the API (exact match, no wildcards).
# Requests from any other Origin are rejected with 403. Default: http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Optional: number of reverse-proxy hops to trust for client IP (used by the rate limiter).
# Leave unset when not behind a proxy.
# TRUST_PROXY=1
